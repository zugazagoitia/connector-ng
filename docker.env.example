# Environment variables for the local evaluation stack (docker-compose.yml).
# Copy this file to `docker.env` (ignored by git) and adjust the values:
#   cp docker.env.example docker.env
#
# Host names are the Compose service names and ports are the ports INSIDE the
# Compose network. These are evaluation values: do not use them in production.

# MySQL
DB_USERNAME=connector
DB_PASSWORD=connector
DB_URL=jdbc:mysql://connector-ng-db:3306/connector
DB_DRIVER_CLASSNAME=com.mysql.cj.jdbc.MysqlXADataSource
DB_DIALECT=org.hibernate.dialect.MySQLDialect

# JWT authentication (at least 32 characters, e.g. the output of `openssl rand -base64 32`)
JWT_SECRET_KEY=<jwt_key>

# S3 (MinIO)
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin123
S3_REGION=us-east-1
S3_BUCKET=attachments
S3_ENDPOINT=http://minio-s3:9000

# Temporary directory
TEMP_DIR_LOCATION=/app/temp

# ActiveMQ
BROKER_URL=tcp://activemq:61616
BROKER_USER=admin
BROKER_PASSWORD=admin
