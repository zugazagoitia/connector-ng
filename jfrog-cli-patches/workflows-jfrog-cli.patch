diff --git a/.github/actions/jfrog-publish-attest/action.yaml b/.github/actions/jfrog-publish-attest/action.yaml
new file mode 100644
index 0000000..fa5272a
--- /dev/null
+++ b/.github/actions/jfrog-publish-attest/action.yaml
@@ -0,0 +1,124 @@
+name: "JFrog: publish build-info, attest and record evidence"
+description: >
+  Finalises a JFrog CLI build: enriches and publishes the build-info, creates
+  GitHub build-provenance and SBOM attestations for every artifact recorded in
+  the build-info, attaches those attestations to the artifacts in Artifactory as
+  JFrog evidence.
+  Requires JFrog CLI to be configured by jfrog/setup-jfrog-cli earlier in the job,
+  with JFROG_CLI_BUILD_NAME and JFROG_CLI_BUILD_NUMBER set, and the job permissions
+  id-token: write and attestations: write.
+
+inputs:
+  sbom-path:
+    description: "Path to a JSON SBOM (CycloneDX or SPDX). When it exists an SBOM attestation is created as well."
+    required: false
+    default: ""
+  attest:
+    description: "Create GitHub build-provenance (and SBOM) attestations for the published artifacts."
+    required: false
+    default: "true"
+  evidence:
+    description: "Attach the attestations to the artifacts in Artifactory as JFrog evidence (requires the JFrog Evidence service / Enterprise+ license)."
+    required: false
+    default: "true"
+  evidence-subject-filter:
+    description: "Extended regular expression selecting which published artifacts receive JFrog evidence."
+    required: false
+    default: '\.(jar|war|ear|zip|tar\.gz)$'
+
+outputs:
+  subjects-file:
+    description: "Path to the sha256 checksums file of all the published artifacts (names are Artifactory repo paths)."
+    value: ${{ steps.subjects.outputs.file }}
+
+runs:
+  using: composite
+  steps:
+    - name: Publish build-info to Artifactory
+      shell: bash
+      run: |
+        set -euo pipefail
+        : "${JFROG_CLI_BUILD_NAME:?JFROG_CLI_BUILD_NAME must be set}"
+        : "${JFROG_CLI_BUILD_NUMBER:?JFROG_CLI_BUILD_NUMBER must be set}"
+        jf rt build-add-git
+        jf rt build-collect-env
+        jf rt build-publish
+
+    - name: Resolve the published artifacts from the build-info
+      id: subjects
+      shell: bash
+      run: |
+        set -euo pipefail
+        out_dir="${RUNNER_TEMP}/jfrog-attest"
+        mkdir -p "${out_dir}"
+        query=$(jq -rn --arg n "${JFROG_CLI_BUILD_NAME}" --arg b "${JFROG_CLI_BUILD_NUMBER}" \
+          '"items.find({\"artifact.module.build.name\":{\"$eq\":\($n|tojson)},\"artifact.module.build.number\":{\"$eq\":\($b|tojson)}}).include(\"repo\",\"path\",\"name\",\"sha256\")"')
+        printf '%s' "${query}" > "${out_dir}/query.aql"
+        jf rt curl --silent --fail -XPOST /api/search/aql -H "Content-Type: text/plain" -T "${out_dir}/query.aql" > "${out_dir}/artifacts.json"
+        jq -r '.results[] | select(.sha256 != null) | "\(.sha256)  \(.repo)/\(if .path == "." then "" else .path + "/" end)\(.name)"' \
+          "${out_dir}/artifacts.json" | sort -u > "${out_dir}/subjects.sha256"
+        count=$(wc -l < "${out_dir}/subjects.sha256")
+        if [ "${count}" -eq 0 ]; then
+          echo "::error::No artifacts found in build ${JFROG_CLI_BUILD_NAME}/${JFROG_CLI_BUILD_NUMBER}"
+          exit 1
+        fi
+        {
+          echo "### Published artifacts (${count})"
+          echo '```'
+          cat "${out_dir}/subjects.sha256"
+          echo '```'
+        } >> "${GITHUB_STEP_SUMMARY}"
+        echo "file=${out_dir}/subjects.sha256" >> "${GITHUB_OUTPUT}"
+
+    - name: Check SBOM
+      id: sbom
+      shell: bash
+      env:
+        SBOM_PATH: ${{ inputs.sbom-path }}
+      run: |
+        if [ -n "${SBOM_PATH}" ] && [ -f "${SBOM_PATH}" ]; then
+          echo "present=true" >> "${GITHUB_OUTPUT}"
+        else
+          [ -n "${SBOM_PATH}" ] && echo "::warning::SBOM '${SBOM_PATH}' not found, skipping the SBOM attestation"
+          echo "present=false" >> "${GITHUB_OUTPUT}"
+        fi
+
+    - name: Attest build provenance
+      id: provenance
+      if: ${{ inputs.attest == 'true' }}
+      uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4.2.2
+      with:
+        subject-checksums: ${{ steps.subjects.outputs.file }}
+
+    - name: Attest SBOM
+      id: sbom-attestation
+      if: ${{ inputs.attest == 'true' && steps.sbom.outputs.present == 'true' }}
+      uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4.2.2
+      with:
+        subject-checksums: ${{ steps.subjects.outputs.file }}
+        sbom-path: ${{ inputs.sbom-path }}
+
+    - name: Attach attestations as JFrog evidence
+      if: ${{ inputs.attest == 'true' && inputs.evidence == 'true' }}
+      shell: bash
+      env:
+        SUBJECTS: ${{ steps.subjects.outputs.file }}
+        FILTER: ${{ inputs.evidence-subject-filter }}
+        PROVENANCE_BUNDLE: ${{ steps.provenance.outputs.bundle-path }}
+        SBOM_BUNDLE: ${{ steps.sbom-attestation.outputs.bundle-path }}
+      run: |
+        set -uo pipefail
+        failures=0
+        while read -r _ subject; do
+          [[ "${subject}" =~ ${FILTER} ]] || continue
+          for bundle in "${PROVENANCE_BUNDLE}" "${SBOM_BUNDLE}"; do
+            [ -n "${bundle}" ] && [ -f "${bundle}" ] || continue
+            if ! jf evd create --sigstore-bundle "${bundle}" --subject-repo-path "${subject}"; then
+              echo "::warning::Could not attach $(basename "${bundle}") to ${subject}"
+              failures=$((failures + 1))
+            fi
+          done
+        done < "${SUBJECTS}"
+        if [ "${failures}" -gt 0 ]; then
+          echo "::warning::${failures} evidence upload(s) failed. The attestations are still available in GitHub (gh attestation verify)."
+        fi
