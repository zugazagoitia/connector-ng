                 required: true
                 type: string
+            sbom-path:
+                description: "Path of the CycloneDX JSON SBOM generated by the 'cyclonedxBom' task"
+                required: false
+                type: string
+                default: "build/reports/cyclonedx/bom.json"
             tag:
                 description: 'The tag to checkout (optional)'
                 required: false
@@ -31,48 +60,90 @@ jobs:
     publish:
         name: Publish Release to Maven Repository
         permissions:
-            contents: write
-            attestations: write
-            id-token: write
+            contents: write     # dependency submission to GitHub
+            id-token: write     # GitHub OIDC token, used for the JFrog login and for signing the attestations
+            attestations: write # store the attestations in GitHub
         runs-on: ubuntu-latest
+        # The environment holds the protection rules (approvals) and is part of the OIDC claims JFrog can check
         environment: ${{ inputs.environment }}
+        env:
+            # Build-info name in Artifactory (the default would be the caller's workflow name, shared between repos)
