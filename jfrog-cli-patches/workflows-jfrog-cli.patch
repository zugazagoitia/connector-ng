+                    ref: ${{ inputs.tag }}
 
+            # Needed by the documentation module (diagrams)
             -   name: Install Graphviz
                 uses: e-CODEX/workflows/.github/actions/install-graphviz@main
 
-            -   name: Checkout tag
-                if: ${{ inputs.tag }}
-                uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
-                with:
-                    ref: ${{ inputs.tag }}
-
             -   name: Setup Java
-                uses: actions/setup-java@de7274f081f381c8f8158605e0321c36c376e2e6 # v6.0.1
+                uses: actions/setup-java@d1374f8ac74474200d16ef8ecee22c7ae7a51880 # v6.3.0
                 with:
                     distribution: 'temurin'
                     java-version: ${{ inputs.java-version }}
 
             -   name: Setup Gradle
-                uses: gradle/actions/setup-gradle@06832c7b30a0129d7fb559bcc6e43d26f6374244 # v4.3.1
+                uses: gradle/actions/setup-gradle@8da46b539cd8fe6ab27ca75128919a18d757604c # v6.4.1
 
+            # Installs a pinned JFrog CLI and logs in with GitHub OIDC (OIDC integration 'setup-jfrog' in JFrog).
+            # Its post step publishes the build-info and creates the JFrog evidence at the end of the job.
             -   name: Setup JFrog CLI
-                uses: jfrog/setup-jfrog-cli@f748a0599171a192a2668afee8d0497f7c1069df # v4.5.6
-                id: setup-jfrog-cli
+                uses: jfrog/setup-jfrog-cli@4c2f06da03095113100534a16d58d8a252680949 # v5.3.5
                 env:
                     JF_URL: https://scm.ecodex.eu
                 with:
+                    version: 2.133.0
                     oidc-provider-name: setup-jfrog
 
+            # Dependency graph for Dependabot alerts / GitHub Advanced Security
             -   name: Submit Dependency Release to GitHub Advanced Security
                 uses: mikepenz/gradle-dependency-submission@v1
 
+            # gradle-config: deploy to 'deploy-repo' with the Gradle wrapper; POMs are deployed, Ivy descriptors
+            # are not (Maven repository). Dependencies keep being resolved from the repositories of the build.
+            # The JFrog Gradle extractor is injected with an init script, which does not support the
+            # configuration cache, hence --no-configuration-cache.
             -   name: Publish Release
                 env:
-                    MAVEN_REPO_ID: ${{ inputs.maven-repo-id }}
-                    MAVEN_REPO_USERNAME: ${{ steps.setup-jfrog-cli.outputs.oidc-user }}
-                    MAVEN_REPO_PASSWORD: ${{ steps.setup-jfrog-cli.outputs.oidc-token }}
-                run: ./gradlew publish ${{ inputs.gradle-parameters }}
+                    DEPLOY_REPO: ${{ inputs.deploy-repo }}
+                    GRADLE_PARAMETERS: ${{ inputs.gradle-parameters }}
+                run: |
+                    jf gradle-config --repo-deploy="${DEPLOY_REPO}" --use-wrapper --deploy-ivy-desc=false
+                    jf gradle clean cyclonedxBom artifactoryPublish --no-configuration-cache ${GRADLE_PARAMETERS}
+
+            # The attestation subject must be the zip's real path in Artifactory (a virtual 'deploy-repo' stores
+            # it in one of its local repositories), so the deployed zip is looked up by its sha256 (AQL).
+            # The SBOM is uploaded next to it; 'jf rt upload' also adds it to the build-info.
+            -   name: Deploy the SBOM next to the distribution
+                id: distribution
+                env:
+                    DISTRIBUTION: ${{ inputs.distribution-path }}
+                    SBOM_PATH: ${{ inputs.sbom-path }}
+                run: |
+                    zip=$(ls ${DISTRIBUTION})
+                    sha=$(sha256sum "${zip}" | cut -d' ' -f1)
+                    target=$(jf rt curl -s -XPOST /api/search/aql -H "Content-Type: text/plain" \
+                      -d "items.find({\"sha256\":\"${sha}\"}).include(\"repo\",\"path\",\"name\")" \
+                      | jq -r '.results[0] // error("distribution not found in Artifactory") | "\(.repo)/\(.path)/\(.name)"')
+                    jf rt upload "${SBOM_PATH}" "${target%.zip}-cyclonedx.json" --flat
+                    echo "subject-name=${target}" >> "${GITHUB_OUTPUT}"
+                    echo "subject-digest=sha256:${sha}" >> "${GITHUB_OUTPUT}"
+
+            # SLSA build provenance: which workflow, commit and runner produced the zip
+            -   name: Attest the distribution provenance
+                uses: actions/attest-build-provenance@4d101475d8b20a2381f78447822ac1eab6504dd8 # v4.2.2
+                with:
+                    subject-name: ${{ steps.distribution.outputs.subject-name }}
+                    subject-digest: ${{ steps.distribution.outputs.subject-digest }}
+
+            # Signed statement that the SBOM describes this zip
+            -   name: Attest the distribution SBOM
+                uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4.2.2
+                with:
+                    subject-name: ${{ steps.distribution.outputs.subject-name }}
+                    subject-digest: ${{ steps.distribution.outputs.subject-digest }}
+                    sbom-path: ${{ inputs.sbom-path }}
